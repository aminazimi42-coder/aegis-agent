#!/bin/sh
# Aegis — local twin launcher (T104, T128).
#
# Starts the existing local FastAPI app bound to 127.0.0.1 only
# (never 0.0.0.0), then opens the stub page with the default
# macOS opener.  Data stays under $HOME/.aegis unless
# AEGIS_DATA_DIR is already set.
#
# T128: if scripts/start_operator.sh exists, exec it so the .app
# uses the same operator start path.  The .app is a wrapper, not a
# store-signed product.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# The repo root is the directory above desktop/macos/Aegis.app/Contents
REPO_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"

# --- T128: delegate to the operator start script if present ---------------
START_OP="$REPO_ROOT/scripts/start_operator.sh"
if [ -f "$START_OP" ]; then
    exec "$START_OP"
fi

# --- resolve python -------------------------------------------------------
PY="${AEGIS_PY:-$REPO_ROOT/.venv/bin/python}"
if [ ! -x "$PY" ]; then
    PY="$(command -v python3 || command -v python || true)"
fi
if [ -z "$PY" ]; then
    echo "Aegis: python not found" >&2
    exit 1
fi

# --- data dir: default to $HOME/.aegis, never the repo data/ -------------
export AEGIS_DATA_DIR="${AEGIS_DATA_DIR:-$HOME/.aegis}"
mkdir -p "$AEGIS_DATA_DIR"

# --- start the local HTTP server on 127.0.0.1 only -----------------------
PORT="${AEGIS_PORT:-8741}"
HOST="127.0.0.1"

# Background the server; it stays alive until the app is quit.
"$PY" -m uvicorn app.server:create_app --factory --host "$HOST" --port "$PORT" &
SERVER_PID=$!

# Give the server a moment to bind, then open the operator page.
# The operator app.html is now served by the local server at / on
# http://127.0.0.1:8741/ — same origin as /health — not as a file:// URL.
sleep 1
open "http://${HOST}:${PORT}/"

# Keep the launcher alive so the server keeps running.
wait "$SERVER_PID"
